being below between both but by can can't cannot could couldn't did didn't do does doesn't doing don't
dont done down during each either else etc even ever every few for from further get gets got had hadn't
has hasn't have haven't having he her here hers herself him himself his how i i'd i'll i'm i've if im in
into is isn't it it's its itself just let let's like make made may me might mine more most much must
my myself need needs no nor not now of off ok okay on once one only or other ought our ours ourselves out
over own please same shall she should shouldn't so some such than that that's the their theirs them
themselves then there there's these they they're this those through thus to too under until up upon us
use used using very via want wants was wasn't way we we'll we're we've well were weren't what what's
when where which while who whom why will with won't would wouldn't yeah yes yet you you'd you'll you're
you've your yours yourself yourselves also still really thing things something anything everything
lets gonna going go goes sure right let's thanks thank hey hi hello okay sorry
""".split())
WORD_RE = re.compile(r"[a-z][a-z0-9'-]+")
HEXISH = re.compile(r"(?=[a-z]*\d)[0-9a-f-]{7,}")


def tokens(clean):
    return WORD_RE.findall(clean.lower())


def content_words(toks):
    out = []
    for w in toks:
        w = w.strip("'-")
        if len(w) < 3 or w in STOPWORDS or HEXISH.fullmatch(w):
            continue
        out.append(w)
    return out


def pct(values, p):
    if not values:
        return 0
    v = sorted(values)
    k = min(len(v) - 1, max(0, int(round((len(v) - 1) * p))))
    return v[k]


def iso_week(d):
    y, w, _ = d.isocalendar()
    return f"{y}-W{w:02d}"


def templates(items, min_sessions=3, top=10, n=5):
    """items: [(session_id, words, raw_example)]. Recurring n-word shingles seen in >= min_sessions
    sessions, merged into longer phrases where they overlap within a message."""
    sh_sessions = collections.defaultdict(set)
    for sid, ws, _ in items:
        for i in range(len(ws) - n + 1):
            sh_sessions[tuple(ws[i:i + n])].add(sid)
    good = {s for s, ss in sh_sessions.items() if len(ss) >= min_sessions}
    if not good:
        return []
    phrases = collections.defaultdict(lambda: [0, set(), None, set()])
    for sid, ws, raw in items:
        i = 0
        L = len(ws)
        while i <= L - n:
            if tuple(ws[i:i + n]) in good:
                j = i
                while j + 1 <= L - n and tuple(ws[j + 1:j + 1 + n]) in good:
                    j += 1
                ph = tuple(ws[i:j + n])
                e = phrases[ph]
                e[0] += 1
                e[1].add(sid)
                if e[2] is None or len(raw) < len(e[2]):
                    e[2] = raw  # the shortest prompt containing the phrase is the clearest example
                e[3].update(tuple(ws[k:k + n]) for k in range(i, j + 1))
                i = j + n
            else:
                i += 1
    ranked = sorted(phrases.items(), key=lambda kv: (-len(kv[1][1]), -kv[1][0], -len(kv[0])))
    kept = []
    for ph, (cnt, sess, ex, shs) in ranked:
        hit = next((k for k in kept if k["_sh"] & shs), None)
        if hit:
            hit["count"] += cnt
            hit["_sess"] |= sess
            continue
        kept.append({"phrase": " ".join(ph), "count": cnt, "_sess": set(sess), "_sh": set(shs),
                     "example": " ".join((ex or "").split())[:160]})
    for k in kept:
        k["sessions"] = len(k.pop("_sess"))
        k.pop("_sh")
    kept.sort(key=lambda k: (-k["sessions"], -k["count"]))
    return kept[:top]


def word_bank(rows, top, with_openers):
    words = collections.Counter()
    wsess = collections.defaultdict(set)
    pairs = collections.Counter()
    openers = collections.Counter()
    items = []
    for sid, clean in rows:
        toks = tokens(clean)
        if with_openers and toks:
            openers[" ".join(toks[:2])] += 1
        cw = content_words(toks)
        for w in set(cw):
            words[w] += 1
            wsess[w].add(sid)
        pairs.update(set(zip(cw, cw[1:])))
        items.append((sid, cw, clean))
    out = {
        "words": [{"word": w, "messages": n, "sessions": len(wsess[w])} for w, n in words.most_common(top)],
        "pairs": [{"pair": " ".join(p), "messages": n} for p, n in pairs.most_common(top)],
        "templates": templates(items, top=min(top, 10)),
    }
    if with_openers:
        out["openers"] = [{"opener": o, "count": n} for o, n in openers.most_common(top)]
    return out


def load_prices():
    try:
        with open(prices_path()) as f:
            p = json.load(f)
        return p if isinstance(p, dict) else None
    except (OSError, ValueError):
        return None


def compute_stats(con, project=None, since=None, top=20):
    cutoff = since_cutoff(since)
    sess = {}
    for r in con.execute("SELECT id, cwd, project_dir, custom_title, ai_title, first_prompt, started, ended, "
                         "n_msgs, n_user, n_assistant FROM sessions"):
        sid, cwd, proj = r[0], r[1], r[2]
        if project and project.lower() not in (cwd or "").lower() and project.lower() not in (proj or "").lower():
            continue
        sess[sid] = r
    ok = set(sess)

    def rows(sql, params=()):
        for r in con.execute(sql, params):
            if r[0] in ok and (not cutoff or (r[1] or "") >= cutoff):
                yield r

    user = list(rows("SELECT session_id, ts, words, lines, queued, clean FROM prompts WHERE role='user'"))
    asst = list(rows("SELECT session_id, ts, words, lines, queued, clean FROM prompts WHERE role='assistant'"))
    active = {r[0] for r in user} | {r[0] for r in asst}
    if cutoff:
        ok_sessions = active
    else:
        ok_sessions = {s for s in ok if sess[s][8]}
    label = {s: short_project(sess[s][1] or sess[s][2]) for s in sess}

    # 1 overview
    days = set()
    week_prompts = collections.Counter()
    grid = [[0] * 24 for _ in range(7)]
    wk_words = collections.defaultdict(list)
    proj_sessions = collections.defaultdict(set)
    proj_prompts = collections.Counter()
    for sid, ts, words, lines, queued, clean in user:
        d = local(ts)
        proj_sessions[label[sid]].add(sid)
        proj_prompts[label[sid]] += 1
        if not d:
            continue
        days.add(d.date())
        week_prompts[iso_week(d)] += 1
        grid[d.weekday()][d.hour] += 1
        wk_words[iso_week(d)].append(words)
    for s in ok_sessions:
        proj_sessions[label[s]].add(s)
    total_prompts = len(user) or 1
    dates = sorted(days)
    overview = {
        "sessions": len(ok_sessions), "prompts": len(user), "queued_prompts": sum(r[4] for r in user),
        "claude_replies": len(asst), "active_days": len(days),
        "first": dates[0].isoformat() if dates else None, "last": dates[-1].isoformat() if dates else None,
        "projects": sorted(({"project": p, "sessions": len(s), "prompts": proj_prompts[p],
                             "share": round(100 * proj_prompts[p] / total_prompts, 1)}
                            for p, s in proj_sessions.items()), key=lambda x: (-x["prompts"], -x["sessions"]))[:top],
    }
    # 2 activity
    names = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    day_tot = [sum(r) for r in grid]
    hour_tot = [sum(grid[d][h] for d in range(7)) for h in range(24)]
    activity = {
        "per_week": [{"week": w, "prompts": n} for w, n in sorted(week_prompts.items())],
        "weekday_hour": {names[i]: grid[i] for i in range(7)},
        "busiest_day": names[day_tot.index(max(day_tot))] if any(day_tot) else None,
        "busiest_hour": hour_tot.index(max(hour_tot)) if any(hour_tot) else None,
    }
    # 3 prompts
    wl = [r[2] for r in user]
    ll = [r[3] for r in user]
    buckets = collections.OrderedDict((("1-5", 0), ("6-20", 0), ("21-60", 0), ("60+", 0)))
    for w in wl:
        buckets["1-5" if w <= 5 else "6-20" if w <= 20 else "21-60" if w <= 60 else "60+"] += 1
    longest = sorted(user, key=lambda r: -r[2])[:5]
    prompts = {
        "words": {"median": pct(wl, .5), "p90": pct(wl, .9), "max": max(wl, default=0)},
        "lines": {"median": pct(ll, .5), "p90": pct(ll, .9), "max": max(ll, default=0)},
        "buckets": dict(buckets),
        "median_words_per_week": [{"week": w, "median": statistics.median(v)} for w, v in sorted(wk_words.items())],
        "longest": [{"date": (local(r[1]).strftime("%Y-%m-%d") if local(r[1]) else None), "project": label[r[0]],
                     "words": r[2], "start": " ".join(r[5].split())[:100]} for r in longest],
    }
    # 4/5 word banks
    your_words = word_bank([(r[0], r[5]) for r in user], top, True)
    cmds = collections.Counter(r[2] for r in rows("SELECT session_id, ts, name FROM events WHERE kind='command'"))
    your_words["commands"] = [{"command": "/" + c, "count": n} for c, n in cmds.most_common(top)]
    claude_words = word_bank([(r[0], r[5]) for r in asst], top, False)
    # 6 conversations
    msgs = []
    turns = []
    durs = []
    longest_s = []
    for s in ok_sessions:
        r = sess[s]
        n_msgs, n_user = r[8] or 0, r[9] or 0
        a, b = parse_ts(r[6]), parse_ts(r[7])
        dur = (b - a).total_seconds() / 60 if a and b else 0
        msgs.append(n_msgs)
        turns.append(n_user)
        durs.append(dur)
        longest_s.append((n_msgs, s, dur))
    longest_s.sort(reverse=True)
    conversations = {
        "messages": {"median": pct(msgs, .5), "p90": pct(msgs, .9), "max": max(msgs, default=0)},
        "turns": {"median": pct(turns, .5), "p90": pct(turns, .9), "max": max(turns, default=0)},
        "minutes": {"median": round(pct(durs, .5)), "p90": round(pct(durs, .9)), "max": round(max(durs, default=0))},
        "longest": [{"id": s, "title": sess[s][3] or sess[s][4] or sess[s][5] or "", "project": label[s],
                     "messages": n, "minutes": round(dur)} for n, s, dur in longest_s[:10]],
    }
    # 7 tools
    tc = collections.Counter(r[2] for r in rows("SELECT session_id, ts, name FROM events WHERE kind='tool'"))
    tools = [{"tool": t, "count": n} for t, n in tc.most_common(top)]
    # 8 code lines
    added = removed = rejected = 0
    by_proj = collections.defaultdict(lambda: [0, 0])
    by_week = collections.defaultdict(lambda: [0, 0])
    by_file = collections.Counter()
    for sid, ts, a, r_, okk, path in rows("SELECT session_id, ts, added, removed, ok, path FROM edits"):
        if not okk:
            rejected += 1
            continue
        added += a or 0
        removed += r_ or 0
        by_proj[label[sid]][0] += a or 0
        by_proj[label[sid]][1] += r_ or 0
        d = local(ts)
        if d:
            by_week[iso_week(d)][0] += a or 0
            by_week[iso_week(d)][1] += r_ or 0
        if path:
            by_file[path] += a or 0
    code_lines = {
        "added": added, "removed": removed, "rejected_or_failed_edits": rejected,
        "by_project": sorted(({"project": p, "added": v[0], "removed": v[1]} for p, v in by_proj.items()),
                             key=lambda x: -x["added"])[:top],
        "by_week": [{"week": w, "added": v[0], "removed": v[1]} for w, v in sorted(by_week.items())],
        "top_files": [{"path": p, "added": n} for p, n in by_file.most_common(10)],
    }
    # 9 tokens
    prices = load_prices()
    keys = ("input", "output", "cache_write", "cache_read")
    by_model = collections.defaultdict(lambda: [0, 0, 0, 0])
    by_proj_t = collections.defaultdict(lambda: [0, 0, 0, 0])
    by_week_t = collections.defaultdict(lambda: collections.defaultdict(lambda: [0, 0, 0, 0]))
    for sid, ts, model, *vals in rows("SELECT session_id, ts, model, input, output, cache_write, cache_read "
                                      "FROM usage"):
        model = model or "?"
        d = local(ts)
        for i, v in enumerate(vals):
            by_model[model][i] += v or 0
            by_proj_t[label[sid]][i] += v or 0
            if d:
                by_week_t[iso_week(d)][model][i] += v or 0

    def cost(model, v):
        p = (prices or {}).get(model)
        if not isinstance(p, dict):
            return None
        return round(sum((v[i] or 0) / 1e6 * float(p.get(k, 0) or 0) for i, k in enumerate(keys)), 2)

    tokens_out = {
        "by_model": sorted(({"model": m, **dict(zip(keys, v)), **({"cost": cost(m, v)} if prices else {})}
                            for m, v in by_model.items()), key=lambda x: -x["output"]),
        "by_project": sorted(({"project": p, **dict(zip(keys, v))} for p, v in by_proj_t.items()),
                             key=lambda x: -x["output"])[:top],
        "by_week": [{"week": w, "models": {m: dict(zip(keys, v)) for m, v in ms.items()}}
                    for w, ms in sorted(by_week_t.items())],
        "total": dict(zip(keys, [sum(v[i] for v in by_model.values()) for i in range(4)])),
        "prices_file": prices_path(),
        "has_prices": bool(prices),
    }
    if prices:
        tokens_out["total"]["cost"] = round(sum(c for c in (cost(m, v) for m, v in by_model.items()) if c), 2)
    return {"overview": overview, "activity": activity, "prompts": prompts, "your_words": your_words,
            "claude_words": claude_words, "conversations": conversations, "tools": tools,
            "code_lines": code_lines, "tokens": tokens_out}


def human(n):
    n = float(n or 0)
    for unit in ("", "K", "M", "B", "T"):
        if abs(n) < 1000:
            return (f"{n:.0f}" if unit == "" else f"{n:.1f}{unit}")
        n /= 1000
    return f"{n:.1f}P"


def print_stats(s):
    o = s["overview"]
    print("== Overview")
    print(f"  sessions {o['sessions']}   your prompts {o['prompts']} (queued {o['queued_prompts']})   "
          f"Claude replies {o['claude_replies']}   active days {o['active_days']}   {o['first']} → {o['last']}")
    for p in o["projects"][:10]:
        print(f"    {p['project']:<40} {p['sessions']:>4} sessions {p['prompts']:>6} prompts {p['share']:>5}%")
    a = s["activity"]
    print("\n== Activity")
    print(f"  busiest day {a['busiest_day']}   busiest hour {a['busiest_hour']}:00")
    print("  prompts per week: " + "  ".join(f"{w['week']}:{w['prompts']}" for w in a["per_week"][-12:]))
    print("       " + " ".join(f"{h:>3}" for h in range(24)))
    for d, row in a["weekday_hour"].items():
        print(f"  {d}  " + " ".join(f"{v:>3}" if v else "  ·" for v in row))
    p = s["prompts"]
    print("\n== Your prompts")
    print(f"  words median {p['words']['median']}  p90 {p['words']['p90']}  max {p['words']['max']}   "
          f"lines median {p['lines']['median']}  p90 {p['lines']['p90']}  max {p['lines']['max']}")
    print("  length: " + "  ".join(f"{k} words: {v}" for k, v in p["buckets"].items()))
    for x in p["longest"]:
        print(f"    {x['date']}  {x['project']}  {x['words']} words: {x['start'][:80]}")
    for key, title in (("your_words", "Word bank: you"), ("claude_words", "Word bank: Claude")):
        w = s[key]
        print(f"\n== {title}")
        print("  words: " + ", ".join(f"{x['word']} {x['messages']}/{x['sessions']}s" for x in w["words"]))
        print("  pairs: " + ", ".join(f"{x['pair']} {x['messages']}" for x in w["pairs"]))
        if "openers" in w:
            print("  openers: " + ", ".join(f"\"{x['opener']}\" {x['count']}" for x in w["openers"]))
        if w["templates"]:
            print("  recurring templates:")
            for t in w["templates"]:
                print(f"    [{t['sessions']} sessions, {t['count']}x] {t['phrase']}")
                print(f"        e.g. {t['example'][:120]}")
        if w.get("commands"):
            print("  slash commands: " + ", ".join(f"{x['command']} {x['count']}" for x in w["commands"]))
    c = s["conversations"]
    print("\n== Conversations")
    print(f"  messages/session median {c['messages']['median']}  p90 {c['messages']['p90']}  max {c['messages']['max']}"
          f"   turns median {c['turns']['median']}  p90 {c['turns']['p90']}"
          f"   minutes median {c['minutes']['median']}  p90 {c['minutes']['p90']}")
    for x in c["longest"]:
        print(f"    {x['messages']:>5} msgs {x['minutes']:>6} min  {x['project']}  {' '.join(x['title'].split())[:60]}"
              f"  {x['id'][:8]}")
    print("\n== Tools")
    print("  " + ", ".join(f"{t['tool']} {t['count']}" for t in s["tools"]))
    cl = s["code_lines"]
    print("\n== Code lines Claude wrote (via Edit/Write tools)")
    print(f"  +{cl['added']:,} / -{cl['removed']:,}   rejected or failed edits: {cl['rejected_or_failed_edits']}")
    for x in cl["by_project"][:10]:
        print(f"    {x['project']:<40} +{x['added']:>9,} -{x['removed']:>8,}")
    print("  per week: " + "  ".join(f"{w['week']}:+{w['added']:,}" for w in cl["by_week"][-12:]))
    print("  top files:")
    for x in cl["top_files"]:
        print(f"    +{x['added']:>7,}  {x['path']}")
    t = s["tokens"]
    print("\n== Tokens")
    tot = t["total"]
    print(f"  input {human(tot['input'])}  output {human(tot['output'])}  cache write {human(tot['cache_write'])}"
          f"  cache read {human(tot['cache_read'])}" + (f"  cost ${tot['cost']:,}" if t["has_prices"] else ""))
    for m in t["by_model"]:
        line = (f"    {m['model']:<24} in {human(m['input']):>7}  out {human(m['output']):>7}  "
                f"cw {human(m['cache_write']):>7}  cr {human(m['cache_read']):>7}")
        if t["has_prices"]:
            line += f"  ${m['cost']:,}" if m.get("cost") is not None else "  (no price)"
        print(line)
    for x in t["by_project"][:10]:
        print(f"    {x['project']:<40} out {human(x['output']):>7}  cache read {human(x['cache_read']):>7}")
    if not t["has_prices"]:
        print(f"  (cost not shown: add per-model $/MTok prices to {t['prices_file']}; see README)")


# ---------------------------------------------------------------- HTML report


def svg_bars(items, width=640, height=180, color="var(--c1)", label_every=1):
    """items: [(label, value)] vertical bars."""
    if not items:
        return "<p class=muted>No data.</p>"
    mx = max(v for _, v in items) or 1
    n = len(items)
    bw = (width - 40) / n
    parts = [f'<svg viewBox="0 0 {width} {height + 30}" role="img" class="chart">']
    for i, (lab, v) in enumerate(items):
        h = (height - 10) * v / mx
        x = 30 + i * bw
        parts.append(f'<rect x="{x + 1:.1f}" y="{height - h:.1f}" width="{max(bw - 2, 1):.1f}" height="{h:.1f}" '
                     f'fill="{color}" rx="2"><title>{html.escape(str(lab))}: {v:,}</title></rect>')
        if i % label_every == 0:
            parts.append(f'<text x="{x + bw / 2:.1f}" y="{height + 14}" text-anchor="middle" class="tick">'
                         f'{html.escape(str(lab))}</text>')
    parts.append(f'<text x="2" y="12" class="tick">{human(mx)}</text></svg>')
    return "".join(parts)


def svg_hbars(items, color, width=300):
    if not items:
        return "<p class=muted>No data.</p>"
    mx = max(v for _, v in items) or 1
    row = 18
    parts = [f'<svg viewBox="0 0 {width} {row * len(items) + 4}" role="img" class="chart">']
    for i, (lab, v) in enumerate(items):
        w = (width - 120) * v / mx
        y = i * row + 2
        parts.append(f'<text x="0" y="{y + 12}" class="tick">{html.escape(lab[:18])}</text>'
                     f'<rect x="110" y="{y + 2}" width="{w:.1f}" height="{row - 6}" fill="{color}" rx="2">'
                     f'<title>{html.escape(lab)}: {v:,}</title></rect>'
                     f'<text x="{114 + w:.1f}" y="{y + 12}" class="tick">{v:,}</text>')
    parts.append("</svg>")
    return "".join(parts)


def svg_heatmap(grid):
    cell = 22
    mx = max((v for row in grid.values() for v in row), default=0) or 1
    parts = [f'<svg viewBox="0 0 {40 + 24 * cell} {len(grid) * cell + 24}" role="img" class="chart">']
    for r, (day, row) in enumerate(grid.items()):
        parts.append(f'<text x="0" y="{r * cell + 15}" class="tick">{day}</text>')
        for h, v in enumerate(row):
            op = 0.08 + 0.92 * (v / mx) if v else 0.03
            parts.append(f'<rect x="{40 + h * cell}" y="{r * cell}" width="{cell - 2}" height="{cell - 2}" rx="3" '
                         f'fill="var(--c1)" fill-opacity="{op:.2f}"><title>{day} {h}:00 — {v}</title></rect>')
    for h in range(0, 24, 3):
        parts.append(f'<text x="{40 + h * cell + cell / 2}" y="{len(grid) * cell + 14}" text-anchor="middle" '
                     f'class="tick">{h}</text>')
    parts.append("</svg>")
    return "".join(parts)


def svg_stacked(weeks, models, width=640, height=180):
    if not weeks:
        return "<p class=muted>No data.</p>"
    colors = ["var(--c1)", "var(--c2)", "var(--c3)", "var(--c4)", "var(--c5)", "var(--c6)"]
    totals = [sum(w["models"].get(m, {}).get("output", 0) for m in models) for w in weeks]
    mx = max(totals) or 1
    bw = (width - 40) / len(weeks)
    parts = [f'<svg viewBox="0 0 {width} {height + 30}" role="img" class="chart">']
    for i, w in enumerate(weeks):
        y = height
        for j, m in enumerate(models):
            v = w["models"].get(m, {}).get("output", 0)
            h = (height - 10) * v / mx
            y -= h
            parts.append(f'<rect x="{30 + i * bw + 1:.1f}" y="{y:.1f}" width="{max(bw - 2, 1):.1f}" height="{h:.1f}" '
                         f'fill="{colors[j % len(colors)]}"><title>{w["week"]} {html.escape(m)}: {v:,}</title></rect>')
        parts.append(f'<text x="{30 + i * bw + bw / 2:.1f}" y="{height + 14}" text-anchor="middle" class="tick">'
                     f'{w["week"][-3:]}</text>')
    parts.append(f'<text x="2" y="12" class="tick">{human(mx)}</text></svg>')
    legend = "".join(f'<span class=key><i style="background:{colors[j % len(colors)]}"></i>{html.escape(m)}</span>'
                     for j, m in enumerate(models))
    return "".join(parts) + f'<div class=legend>{legend}</div>'


CSS = """
:root{--bg:#fbfaf8;--fg:#1d1c1a;--muted:#6b6862;--card:#fff;--line:#e6e2dc;
--c1:#3b6fb6;--c2:#d9822b;--c3:#3a9d7a;--c4:#a35bb5;--c5:#c9474d;--c6:#8a8f36}
@media (prefers-color-scheme: dark){:root{--bg:#161615;--fg:#ecebe8;--muted:#9c9890;--card:#1f1f1d;--line:#34332f;
--c1:#6c9be0;--c2:#f0a35a;--c3:#5cc49d;--c4:#c68ad6;--c5:#e87278;--c6:#b8bd5c}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);
font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
main{max-width:1000px;margin:0 auto;padding:24px 16px 64px}h1{font-size:24px;margin:0 0 4px}
h2{font-size:17px;margin:0 0 12px}.muted{color:var(--muted)}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;margin:16px 0;overflow-x:auto}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}
.kpi b{display:block;font-size:22px}.kpi span{color:var(--muted);font-size:13px}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
table{border-collapse:collapse;width:100%;font-size:13px}td,th{padding:4px 6px;border-bottom:1px solid var(--line);
text-align:left;vertical-align:top}td.n{text-align:right;font-variant-numeric:tabular-nums}
.chart{width:100%;height:auto}.tick{font-size:10px;fill:var(--muted)}
.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--muted)}
.key i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:4px}
.tpl{margin:6px 0}.tpl code{font-size:12px;color:var(--muted)}
"""


def _table(headers, rows):
    h = "".join(f"<th>{html.escape(x)}</th>" for x in headers)
    body = "".join("<tr>" + "".join(
        f'<td class="n">{v:,}</td>' if isinstance(v, (int, float)) and not isinstance(v, bool)
        else f"<td>{html.escape(str(v))}</td>" for v in r) + "</tr>" for r in rows)
    return f"<table><tr>{h}</tr>{body}</table>"


def render_html(s):
    o, a, p, c, cl, t = s["overview"], s["activity"], s["prompts"], s["conversations"], s["code_lines"], s["tokens"]
    kp = [("sessions", o["sessions"]), ("your prompts", o["prompts"]), ("Claude replies", o["claude_replies"]),
          ("active days", o["active_days"]), ("lines added", cl["added"]), ("output tokens", human(t["total"]["output"]))]
    kpis = "".join(f'<div class=kpi><b>{v if isinstance(v, str) else f"{v:,}"}</b><span>{k}</span></div>' for k, v in kp)
    weeks = [(w["week"][-3:], w["prompts"]) for w in a["per_week"]]
    lines_w = [(w["week"][-3:], w["added"]) for w in cl["by_week"]]
    models = [m["model"] for m in t["by_model"]]

    def tpl(w):
        if not w["templates"]:
            return "<p class=muted>None found in 3+ sessions.</p>"
        return "".join(f'<div class=tpl><b>{html.escape(x["phrase"])}</b> <span class=muted>'
                       f'({x["sessions"]} sessions, {x["count"]}×)</span><br><code>{html.escape(x["example"])}</code></div>'
                       for x in w["templates"])

    yw, cw = s["your_words"], s["claude_words"]
    sections = [
        f'<div class="card kpis">{kpis}</div>',
        f'<div class=card><h2>Prompts per week</h2>{svg_bars(weeks)}'
        f'<p class=muted>Busiest day {a["busiest_day"]}, busiest hour {a["busiest_hour"]}:00 (local time).</p></div>',
        f'<div class=card><h2>When you work (weekday × hour)</h2>{svg_heatmap(a["weekday_hour"])}</div>',
        '<div class="card"><h2>Top words</h2><div class=two>'
        f'<div><h3>You</h3>{svg_hbars([(x["word"], x["messages"]) for x in yw["words"][:15]], "var(--c1)")}</div>'
        f'<div><h3>Claude</h3>{svg_hbars([(x["word"], x["messages"]) for x in cw["words"][:15]], "var(--c2)")}</div>'
        '</div></div>',
        '<div class=card><h2>How your requests usually look</h2><div class=two><div>'
        + _table(["opener", "count"], [(x["opener"], x["count"]) for x in yw.get("openers", [])[:12]])
        + "</div><div>"
        + _table(["words per prompt", "prompts"], list(p["buckets"].items()))
        + f'<p class=muted>median {p["words"]["median"]} words, p90 {p["words"]["p90"]}, '
          f'median {p["lines"]["median"]} line(s)</p>'
        + _table(["slash command", "count"], [(x["command"], x["count"]) for x in yw.get("commands", [])[:10]])
        + f"</div></div><h3>Recurring templates (yours)</h3>{tpl(yw)}"
          f"<h3>Recurring phrases (Claude)</h3>{tpl(cw)}</div>",
        '<div class=card><h2>Word pairs</h2><div class=two><div>'
        + _table(["you", "count"], [(x["pair"], x["messages"]) for x in yw["pairs"][:15]]) + "</div><div>"
        + _table(["Claude", "count"], [(x["pair"], x["messages"]) for x in cw["pairs"][:15]]) + "</div></div></div>",
        f'<div class=card><h2>Code lines Claude wrote per week</h2>{svg_bars(lines_w, color="var(--c3)")}'
        f'<p class=muted>+{cl["added"]:,} / −{cl["removed"]:,} via Edit/Write tools; '
        f'{cl["rejected_or_failed_edits"]} rejected or failed edits excluded.</p><div class=two><div>'
        + _table(["project", "added", "removed"], [(x["project"], x["added"], x["removed"]) for x in cl["by_project"][:10]])
        + "</div><div>" + _table(["file", "added"], [(x["path"], x["added"]) for x in cl["top_files"]]) + "</div></div></div>",
        f'<div class=card><h2>Output tokens per week by model</h2>{svg_stacked(t["by_week"], models)}'
        + _table(["model", "input", "output", "cache write", "cache read"] + (["cost $"] if t["has_prices"] else []),
                 [(m["model"], m["input"], m["output"], m["cache_write"], m["cache_read"])
                  + ((m.get("cost") if m.get("cost") is not None else "-",) if t["has_prices"] else ())
                  for m in t["by_model"]])
        + ("" if t["has_prices"] else f'<p class=muted>Cost not shown: add prices to {html.escape(t["prices_file"])}.</p>')
        + "</div>",
        '<div class=card><h2>Conversations</h2>'
        f'<p class=muted>messages per session: median {c["messages"]["median"]}, p90 {c["messages"]["p90"]}; '
        f'minutes: median {c["minutes"]["median"]}, p90 {c["minutes"]["p90"]}</p>'
        + _table(["messages", "minutes", "project", "title", "id"],
                 [(x["messages"], x["minutes"], x["project"], x["title"][:70], x["id"][:8]) for x in c["longest"]])
        + "</div>",
        '<div class=card><h2>Projects</h2>'
        + _table(["project", "sessions", "prompts", "share %"],
                 [(x["project"], x["sessions"], x["prompts"], x["share"]) for x in o["projects"]]) + "</div>",
        '<div class=card><h2>Tools</h2>' + svg_hbars([(x["tool"], x["count"]) for x in s["tools"][:15]], "var(--c4)",
                                                   width=420) + "</div>",
    ]
    return ("<!doctype html><html lang=en><head><meta charset=utf-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1'><title>Claude Code usage</title>"
            f"<style>{CSS}</style></head><body><main><h1>Claude Code usage</h1>"
            f'<p class=muted>{o["first"]} → {o["last"]} · generated {dt.date.today().isoformat()} by ccfind</p>'
            + "".join(sections) + "</main></body></html>")


# ---------------------------------------------------------------- CLI

COMMANDS = {"search", "open", "show", "index", "stats"}


def build_parser():
    ap = argparse.ArgumentParser(prog="ccfind", description="Search and summarise Claude Code sessions locally.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("search", help="rank sessions matching all terms (default command)")
    s.add_argument("terms", nargs="+")
    s.add_argument("-p", "--project")
    s.add_argument("-b", "--branch")
    s.add_argument("--since")
    s.add_argument("-n", type=int, default=10)
    s.add_argument("--any", action="store_true", help="match any term instead of all")
    s.add_argument("--raw", action="store_true", help="pass FTS5 query syntax through unchanged")
    s.add_argument("--json", action="store_true")
    s.add_argument("--no-agents", action="store_true", help="ignore subagent transcripts")
    s.add_argument("--no-tmp", action="store_true", help="ignore sessions under /tmp")
    s.add_argument("--exclude-current", action="store_true", help="ignore $CLAUDE_CODE_SESSION_ID")
    s.add_argument("--no-index", action="store_true", help="skip the incremental index update")
    o = sub.add_parser("open", help="print (or run with -x) the command that resumes a session")
    o.add_argument("ref", help="result number from the last search, or a session id prefix")
    o.add_argument("-x", action="store_true", help="run it (refused inside Claude Code)")
    sh = sub.add_parser("show", help="print a condensed transcript")
    sh.add_argument("ref")
    sh.add_argument("-g", help="only messages matching this term")
    i = sub.add_parser("index", help="update the index")
    i.add_argument("--full", action="store_true", help="rebuild from scratch")
    i.add_argument("--mode", choices=["text", "deep"], help="text (default) or deep (adds tool calls/output)")
    i.add_argument("--stats", action="store_true", help="print what was done")
    st = sub.add_parser("stats", help="word bank and usage stats")
    st.add_argument("-p", "--project")
    st.add_argument("--since")
    st.add_argument("--top", type=int, default=20)
    st.add_argument("--json", action="store_true")
    st.add_argument("--html", metavar="FILE", help="also write a self-contained HTML report")
    st.add_argument("--no-index", action="store_true")
    return ap


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] not in COMMANDS and argv[0] not in ("-h", "--help"):
        argv.insert(0, "search")
    args = build_parser().parse_args(argv)
    cons = []
    try:
        return run(args, cons)
    finally:
        for c in cons:
            c.close()


def run(args, cons):
    if args.cmd == "index":
        con = connect()
        cur_mode = get_mode(con)
        if args.full or (args.mode and args.mode != cur_mode):
            con.close()
            con = connect(rebuild=True, mode=args.mode or cur_mode)
        cons.append(con)
        c = index_all(con)
        if args.stats:
            size = sum(os.path.getsize(db_path() + x) for x in ("", "-wal") if os.path.exists(db_path() + x))
            print(f"mode {get_mode(con)}  files {c['files']}  changed {c['changed']}  reset {c['reset']}  "
                  f"pruned {c['pruned']}  rows +{c['rows']}  skipped {c['skipped']}  {c['secs']}s  "
                  f"db {size / 1e6:.1f} MB")
        return 0
    con = connect()
    cons.append(con)
    if not getattr(args, "no_index", False) and args.cmd in ("search", "stats"):
        index_all(con)
    elif args.cmd in ("open", "show"):
        index_all(con)
    if args.cmd == "search":
        res = search(con, args.terms, any_=args.any, raw=args.raw, no_agents=args.no_agents, no_tmp=args.no_tmp,
                     exclude_current=args.exclude_current, project=args.project, branch=args.branch,
                     since=args.since, limit=args.n)
        save_last(res)
        if args.json:
            print(json.dumps(res, indent=1))
        else:
            print_results(res)
        return 0
    if args.cmd == "open":
        return cmd_open(con, args)
    if args.cmd == "show":
        return cmd_show(con, args)
    if args.cmd == "stats":
        s = compute_stats(con, project=args.project, since=args.since, top=args.top)
        if args.html:
            with open(args.html, "w") as f:
                f.write(render_html(s))
            os.chmod(args.html, 0o600)
        if args.json:
            print(json.dumps(s, indent=1, default=str))
        elif not args.html:
            print_stats(s)
        else:
            print(f"wrote {args.html}")
        return 0
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
