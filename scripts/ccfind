#!/usr/bin/env python3
"""ccfind: local full-text search and usage stats over Claude Code session transcripts.

Reads ~/.claude/projects/**/*.jsonl (read-only), keeps an incremental SQLite FTS5 index in
~/.cache/ccfind/index.db, and answers queries without calling any model.
Standard library only.
"""
import argparse
import collections
import datetime as dt
import hashlib
import html
import json
import math
import os
import re
import shlex
import sqlite3
import statistics
import sys
import time

SCHEMA_VERSION = "2"
TEXT_CAP = 16384
TOOL_CAP = 2048
LIVE_SECS = 120
EDIT_TOOLS = ("Edit", "MultiEdit", "Write", "NotebookEdit")

# ---------------------------------------------------------------- paths


def projects_root():
    if os.environ.get("CCFIND_ROOT"):
        return os.environ["CCFIND_ROOT"]
    base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    return os.path.join(base, "projects")


def db_path():
    return os.environ.get("CCFIND_DB") or os.path.expanduser("~/.cache/ccfind/index.db")


def last_path():
    return os.path.join(os.path.dirname(db_path()), "last.json")


def prices_path():
    return os.environ.get("CCFIND_PRICES") or os.path.expanduser("~/.config/ccfind/prices.json")


# ---------------------------------------------------------------- schema

SCHEMA = """
CREATE TABLE meta(key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE files(path TEXT PRIMARY KEY, file_id INTEGER UNIQUE, session_id TEXT, kind TEXT,
                   inode INTEGER, size INTEGER, offset INTEGER, head_hash TEXT);
CREATE INDEX files_s ON files(session_id);
CREATE TABLE sessions(id TEXT PRIMARY KEY, project_dir TEXT, cwd TEXT, cwd_src TEXT, last_cwd TEXT,
                      branches TEXT, custom_title TEXT, ai_title TEXT, first_prompt TEXT,
                      started TEXT, ended TEXT, n_msgs INTEGER DEFAULT 0, n_user INTEGER DEFAULT 0,
                      n_assistant INTEGER DEFAULT 0, path TEXT, is_tmp INTEGER DEFAULT 0,
                      meta_rowid INTEGER);
-- docs holds the text; msgs is an external-content FTS5 index over it, kept in sync by triggers,
-- so rows can be deleted per file through an ordinary index.
CREATE TABLE docs(id INTEGER PRIMARY KEY, file_id INTEGER, session_id TEXT, role TEXT, ts TEXT, text TEXT);
CREATE INDEX docs_f ON docs(file_id);
CREATE INDEX docs_s ON docs(session_id, role);
CREATE VIRTUAL TABLE msgs USING fts5(file_id UNINDEXED, session_id UNINDEXED, role UNINDEXED,
                                     ts UNINDEXED, text, content='docs', content_rowid='id',
                                     tokenize='porter unicode61', prefix='2 3');
CREATE TRIGGER docs_ai AFTER INSERT ON docs BEGIN
  INSERT INTO msgs(rowid, file_id, session_id, role, ts, text)
  VALUES (new.id, new.file_id, new.session_id, new.role, new.ts, new.text);
END;
CREATE TRIGGER docs_ad AFTER DELETE ON docs BEGIN
  INSERT INTO msgs(msgs, rowid, file_id, session_id, role, ts, text)
  VALUES ('delete', old.id, old.file_id, old.session_id, old.role, old.ts, old.text);
END;
CREATE TABLE usage(file_id INTEGER, session_id TEXT, msg_id TEXT, ts TEXT, model TEXT,
                   input INTEGER, output INTEGER, cache_write INTEGER, cache_read INTEGER,
                   PRIMARY KEY(file_id, msg_id));
CREATE TABLE edits(file_id INTEGER, session_id TEXT, tool_use_id TEXT, ts TEXT, tool TEXT, path TEXT,
                   added INTEGER, removed INTEGER, ok INTEGER DEFAULT 1, PRIMARY KEY(file_id, tool_use_id));
CREATE TABLE events(file_id INTEGER, session_id TEXT, ts TEXT, kind TEXT, name TEXT);
CREATE TABLE prompts(file_id INTEGER, session_id TEXT, ts TEXT, role TEXT, words INTEGER,
                     lines INTEGER, queued INTEGER, clean TEXT);
CREATE INDEX usage_s ON usage(session_id);
CREATE INDEX edits_s ON edits(session_id, tool_use_id);
CREATE INDEX events_s ON events(session_id);
CREATE INDEX events_f ON events(file_id);
CREATE INDEX prompts_s ON prompts(session_id, role);
CREATE INDEX prompts_f ON prompts(file_id);
"""
PER_FILE_TABLES = ("docs", "usage", "edits", "events", "prompts")


def _remove_db_files(path):
    for suffix in ("", "-wal", "-shm"):
        try:
            os.remove(path + suffix)
        except FileNotFoundError:
            pass


def _secure(path):
    for suffix in ("", "-wal", "-shm"):
        try:
            os.chmod(path + suffix, 0o600)
        except OSError:
            pass


def connect(rebuild=False, mode=None):
    """Open the index, creating or rebuilding it when needed. Returns a connection in autocommit mode."""
    os.umask(0o077)
    path = db_path()
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    if rebuild:
        _remove_db_files(path)
    con = None
    try:
        con = sqlite3.connect(path, isolation_level=None, timeout=5)
        row = con.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
        if not row or row[0] != SCHEMA_VERSION:
            raise sqlite3.DatabaseError("schema mismatch")
    except sqlite3.DatabaseError:
        if con is not None:
            con.close()
        old_mode = None if rebuild else _peek_mode(path)
        _remove_db_files(path)
        con = sqlite3.connect(path, isolation_level=None, timeout=5)
        con.executescript(SCHEMA)
        con.execute("INSERT INTO meta VALUES('schema_version', ?)", (SCHEMA_VERSION,))
        con.execute("INSERT INTO meta VALUES('mode', ?)", (mode or old_mode or "text",))
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA busy_timeout=5000")
    con.execute("PRAGMA synchronous=NORMAL")
    _secure(path)
    return con


def _peek_mode(path):
    if not os.path.exists(path):
        return None
    c = None
    try:
        c = sqlite3.connect(path)
        row = c.execute("SELECT value FROM meta WHERE key='mode'").fetchone()
        return row[0] if row and row[0] in ("text", "deep") else None
    except sqlite3.DatabaseError:
        return None
    finally:
        if c is not None:
            c.close()


def get_mode(con):
    row = con.execute("SELECT value FROM meta WHERE key='mode'").fetchone()
    return row[0] if row else "text"


# ---------------------------------------------------------------- text extraction

NOISE_PREFIXES = (
    "<task-notification>", "<local-command-caveat>", "<local-command-stdout>",
    "<local-command-stderr>", "<system-reminder>", "<fork-boilerplate>", "[Request interrupted",
    "<bash-stdout>", "<bash-stderr>",
)
CMD_NAME = re.compile(r"<command-name>\s*/?(.*?)\s*</command-name>", re.S)
CMD_ARGS = re.compile(r"<command-args>(.*?)</command-args>", re.S)
BASH_IN = re.compile(r"<bash-input>(.*?)</bash-input>", re.S)


def classify(s):
    """Classify one piece of user text. Returns None for injected noise, else (kind, text, cmd)
    with kind in prompt|command|bash."""
    if not isinstance(s, str):
        return None
    t = s.strip()
    if not t or t.startswith(NOISE_PREFIXES):
        return None
    if t.startswith("<command-"):
        m = CMD_NAME.search(t)
        if m:
            a = CMD_ARGS.search(t)
            args = a.group(1).strip() if a else ""
            name = m.group(1).strip()
            return ("command", ("/" + name + " " + args).strip(), name, args)
        return None
    if t.startswith("<bash-input>"):
        m = BASH_IN.search(t)
        return ("bash", "!" + (m.group(1).strip() if m else ""), None, None)
    return ("prompt", t, None, None)


PASTE = re.compile(r"<pasted_content[^>]*>.*?</pasted_content[^>]*>", re.S)
FENCE = re.compile(r"```.*?(?:```|\Z)", re.S)
INLINE = re.compile(r"`[^`\n]*`")
URL = re.compile(r"\b[a-z][a-z0-9+.-]*://\S+", re.I)
IMG = re.compile(r"\[Image #\d+\]")
TAG_BLOCK = re.compile(r"<(system-reminder|command-[a-z]+|local-command-[a-z]+)>.*?</\1>", re.S)
PATHISH = re.compile(r"(?<!\w)(?:~|\.{1,2})?/[^\s]+|\S+/\S+")


# Lines that look like pasted terminal/log output rather than prose.
LOGLINE = re.compile(r"➜|^\s*(?:\$|>|#|==>|-->|\+|-\s|\||at\s)|git:\(|\d{1,2}:\d{2}:\d{2}|\b[A-Z_]{3,}=|"
                     r"^\s*[\[{(]|[{};]\s*$|\\\s*$|\s-{1,2}[a-z][\w-]*(?:[= ]|$)|[✓✗✔✘│├└─•·]|"
                     r"^\s*(?:npm (?:error|warn)|error:|warning:|info\b|debug\b|remote:|fast-forward|"
                     r"environment variables loaded)", re.I)


def prose_line(line):
    t = line.strip()
    if not t:
        return False
    if LOGLINE.search(t):
        return False
    visible = [ch for ch in t if not ch.isspace()]
    letters = sum(ch.isalpha() for ch in visible)
    return letters >= 0.75 * len(visible)


def clean_text(s):
    s = PASTE.sub(" ", s)
    s = TAG_BLOCK.sub(" ", s)
    s = FENCE.sub(" ", s)
    s = INLINE.sub(" ", s)
    s = "\n".join(line for line in s.splitlines() if prose_line(line))
    s = URL.sub(" ", s)
    s = IMG.sub(" ", s)
    s = PATHISH.sub(" ", s)
    return re.sub(r"[ \t]+", " ", s).strip()


def block_texts(content):
    """Yield text strings from a message content (str or list of blocks)."""
    if isinstance(content, str):
        yield content
    elif isinstance(content, list):
        for b in content:
            if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str):
                yield b["text"]


def flatten(v, out, budget):
    if len(out) and sum(len(x) for x in out) >= budget:
        return
    if isinstance(v, str):
        out.append(v)
    elif isinstance(v, dict):
        for x in v.values():
            flatten(x, out, budget)
    elif isinstance(v, list):
        for x in v:
            flatten(x, out, budget)


def tool_text(v):
    out = []
    flatten(v, out, TOOL_CAP)
    return " ".join(out)[:TOOL_CAP]


def nlines(s):
    return (s.count("\n") + 1) if isinstance(s, str) and s else 0


def edit_lines(name, inp):
    if not isinstance(inp, dict):
        return 0, 0
    if name == "Edit":
        return nlines(inp.get("new_string")), nlines(inp.get("old_string"))
    if name == "MultiEdit":
        a = r = 0
        for e in inp.get("edits") or []:
            if isinstance(e, dict):
                a += nlines(e.get("new_string"))
                r += nlines(e.get("old_string"))
        return a, r
    if name == "Write":
        return nlines(inp.get("content")), 0
    if name == "NotebookEdit":
        return nlines(inp.get("new_source")), 0
    return 0, 0


def encode_dir(path):
    return re.sub(r"[^A-Za-z0-9]", "-", path)


# ---------------------------------------------------------------- indexing


class Chunk:
    """Rows and session metadata extracted from one run over new lines of one file."""

    def __init__(self):
        self.docs = []      # (role, ts, text)
        self.prompts = []   # (ts, role, words, lines, queued, clean)
        self.usage = {}     # msg_id -> [ts, model, in, out, cw, cr]
        self.edits = []     # (tool_use_id, ts, tool, path, added, removed)
        self.errors = []    # tool_use_ids with is_error
        self.events = []    # (ts, kind, name)
        self.ts_min = self.ts_max = None
        self.cwds = []      # in order
        self.relocated = None
        self.branches = set()
        self.custom_title = None
        self.ai_title = None
        self.first_prompt = None
        self.n_user = self.n_assistant = 0
        self.skipped = 0

    def seen_ts(self, ts):
        if isinstance(ts, str) and ts:
            if self.ts_min is None or ts < self.ts_min:
                self.ts_min = ts
            if self.ts_max is None or ts > self.ts_max:
                self.ts_max = ts

    def add_prompt(self, ts, text, queued, kind, args):
        self.docs.append(("user", ts, text[:TEXT_CAP]))
        self.n_user += 1
        stat_src = args if kind == "command" else (text if kind == "prompt" else "")
        if stat_src:
            c = clean_text(stat_src)
            if c:
                self.prompts.append((ts, "user", len(c.split()), nlines(stat_src), 1 if queued else 0, c[:TEXT_CAP]))
        if self.first_prompt is None and kind == "prompt":
            self.first_prompt = " ".join(text.split())[:200]


def extract(rec, kind, mode, ch):
    """Fold one transcript record into the chunk."""
    if not isinstance(rec, dict):
        ch.skipped += 1
        return
    t = rec.get("type")
    ts = rec.get("timestamp")
    main = kind == "main"
    if main:
        if isinstance(rec.get("cwd"), str) and rec["cwd"]:
            ch.cwds.append(rec["cwd"])
        if isinstance(rec.get("gitBranch"), str) and rec["gitBranch"]:
            ch.branches.add(rec["gitBranch"])
        if t == "relocated" and isinstance(rec.get("relocatedCwd"), str):
            ch.relocated = rec["relocatedCwd"]
            return
        if t == "custom-title" and isinstance(rec.get("customTitle"), str):
            ch.custom_title = rec["customTitle"].strip() or None
            return
        if t == "ai-title" and isinstance(rec.get("aiTitle"), str):
            ch.ai_title = rec["aiTitle"].strip() or None
            return
    if t == "attachment":
        a = rec.get("attachment")
        if (main and isinstance(a, dict) and a.get("type") == "queued_command"
                and (a.get("origin") or {}).get("kind") == "human"
                and a.get("commandMode") in (None, "prompt")):
            ch.seen_ts(ts)
            for s in block_texts(a.get("prompt")):
                c = classify(s)
                if c:
                    ch.add_prompt(ts, c[1], True, c[0], c[3])
        return
    if t not in ("user", "assistant"):
        return
    msg = rec.get("message")
    if not isinstance(msg, dict):
        ch.skipped += 1
        return
    content = msg.get("content")
    if not isinstance(content, (str, list)):
        ch.skipped += 1
        return
    ch.seen_ts(ts)
    if t == "user":
        if rec.get("isMeta") or rec.get("isCompactSummary"):
            return
        if isinstance(content, list):
            for b in content:
                if not isinstance(b, dict) or b.get("type") != "tool_result":
                    continue
                if b.get("is_error") and b.get("tool_use_id"):
                    ch.errors.append(b["tool_use_id"])
                if mode == "deep":
                    txt = _result_text(b.get("content"))
                    if txt.strip():
                        ch.docs.append(("tool", ts, txt))
        for s in block_texts(content):
            c = classify(s)
            if not c:
                continue
            if kind == "agent":
                continue  # the parent's prompt to a subagent is Claude's text, not the user's
            if c[0] == "command":
                ch.events.append((ts, "command", c[2]))
            ch.add_prompt(ts, c[1], False, c[0], c[3])
        return
    # assistant
    usage = msg.get("usage")
    model = msg.get("model")
    if isinstance(usage, dict) and model != "<synthetic>":
        mid = msg.get("id") or rec.get("requestId") or rec.get("uuid")
        vals = [usage.get("input_tokens") or 0, usage.get("output_tokens") or 0,
                usage.get("cache_creation_input_tokens") or 0, usage.get("cache_read_input_tokens") or 0]
        prev = ch.usage.get(mid)
        if prev:
            ch.usage[mid] = [prev[0], prev[1]] + [max(a, b) for a, b in zip(prev[2:], vals)]
        else:
            ch.usage[mid] = [ts, model] + vals
    if isinstance(content, str):
        content = [{"type": "text", "text": content}]
    for b in content:
        if not isinstance(b, dict):
            continue
        bt = b.get("type")
        if bt == "text" and isinstance(b.get("text"), str) and b["text"].strip():
            text = b["text"].strip()
            ch.docs.append(("assistant" if main else "agent", ts, text[:TEXT_CAP]))
            if main and model != "<synthetic>":  # synthetic = client-side error notices, not Claude
                ch.n_assistant += 1
                c = clean_text(text)
                if c:
                    ch.prompts.append((ts, "assistant", len(c.split()), nlines(text), 0, c[:TEXT_CAP]))
        elif bt == "tool_use":
            name = b.get("name") or "?"
            ch.events.append((ts, "tool", name))
            if name in EDIT_TOOLS and b.get("id"):
                inp = b.get("input") or {}
                a, r = edit_lines(name, inp)
                path = inp.get("file_path") or inp.get("notebook_path") if isinstance(inp, dict) else None
                ch.edits.append((b["id"], ts, name, path, a, r))
            if mode == "deep":
                txt = (name + " " + tool_text(b.get("input"))).strip()
                ch.docs.append(("tool", ts, txt[:TOOL_CAP]))


def _result_text(c):
    if isinstance(c, str):
        return c[:TOOL_CAP]
    parts = []
    if isinstance(c, list):
        for x in c:
            if isinstance(x, dict) and x.get("type") == "text" and isinstance(x.get("text"), str):
                parts.append(x["text"])
    return " ".join(parts)[:TOOL_CAP]


def walk(root):
    """Yield (path, session_id, kind, project_dir) for every transcript file."""
    try:
        projects = sorted(os.listdir(root))
    except FileNotFoundError:
        return
    for proj in projects:
        pdir = os.path.join(root, proj)
        if not os.path.isdir(pdir):
            continue
        try:
            entries = sorted(os.listdir(pdir))
        except OSError:
            continue
        for name in entries:
            p = os.path.join(pdir, name)
            if name.endswith(".jsonl") and os.path.isfile(p):
                yield p, name[:-6], "main", proj
            elif os.path.isdir(p):
                sub = os.path.join(p, "subagents")
                if os.path.isdir(sub):
                    for an in sorted(os.listdir(sub)):
                        ap = os.path.join(sub, an)
                        if an.endswith(".jsonl") and os.path.isfile(ap):
                            yield ap, name, "agent", proj


def head_hash(path):
    with open(path, "rb") as f:
        return hashlib.sha1(f.read(4096)).hexdigest()


def delete_file_rows(con, file_id):
    for t in PER_FILE_TABLES:
        con.execute(f"DELETE FROM {t} WHERE file_id=?", (file_id,))


def drop_session(con, sid):
    row = con.execute("SELECT meta_rowid FROM sessions WHERE id=?", (sid,)).fetchone()
    if row and row[0] is not None:
        con.execute("DELETE FROM docs WHERE id=?", (row[0],))
    con.execute("DELETE FROM sessions WHERE id=?", (sid,))


def merge_session(con, sid, proj, path, ch):
    row = con.execute("SELECT cwd, cwd_src, last_cwd, branches, custom_title, ai_title, first_prompt, "
                      "started, ended, n_msgs, n_user, n_assistant FROM sessions WHERE id=?", (sid,)).fetchone()
    if row is None:
        con.execute("INSERT INTO sessions(id, project_dir, path) VALUES(?,?,?)", (sid, proj, path))
        row = (None, None, None, "", None, None, None, None, None, 0, 0, 0)
    cwd, src, last, branches, ctitle, atitle, first, started, ended, n_msgs, n_user, n_asst = row
    if ch.relocated:
        cwd, src = ch.relocated, "relocated"
    elif src not in ("relocated", "match"):
        match = next((c for c in ch.cwds if encode_dir(c) == proj), None)
        if match:
            cwd, src = match, "match"
        elif cwd is None and ch.cwds:
            cwd, src = ch.cwds[0], "fallback"
    if ch.cwds:
        last = ch.cwds[-1]
    bset = set(filter(None, (branches or "").split(","))) | ch.branches
    ctitle = ch.custom_title or ctitle
    atitle = ch.ai_title or atitle
    first = first or ch.first_prompt
    started = min(filter(None, [started, ch.ts_min]), default=None)
    ended = max(filter(None, [ended, ch.ts_max]), default=None)
    n_user += ch.n_user
    n_asst += ch.n_assistant
    is_tmp = 1 if (cwd or "").startswith(("/private/tmp", "/tmp")) else 0
    con.execute("UPDATE sessions SET cwd=?, cwd_src=?, last_cwd=?, branches=?, custom_title=?, ai_title=?, "
                "first_prompt=?, started=?, ended=?, n_msgs=?, n_user=?, n_assistant=?, is_tmp=?, path=? WHERE id=?",
                (cwd, src, last, ",".join(sorted(bset)), ctitle, atitle, first, started, ended,
                 n_user + n_asst, n_user, n_asst, is_tmp, path, sid))


def ensure_session(con, sid, proj, ch):
    """Agent files only contribute timestamps; make sure a session row exists for them."""
    row = con.execute("SELECT started, ended FROM sessions WHERE id=?", (sid,)).fetchone()
    if row is None:
        con.execute("INSERT INTO sessions(id, project_dir) VALUES(?,?)", (sid, proj))
        row = (None, None)
    started = min(filter(None, [row[0], ch.ts_min]), default=None)
    ended = max(filter(None, [row[1], ch.ts_max]), default=None)
    con.execute("UPDATE sessions SET started=?, ended=? WHERE id=?", (started, ended, sid))


def refresh_meta(con, sid):
    row = con.execute("SELECT meta_rowid, custom_title, ai_title, cwd, project_dir, branches FROM sessions "
                      "WHERE id=?", (sid,)).fetchone()
    if not row:
        return
    meta_rowid, ctitle, atitle, cwd, proj, branches = row
    text = " ".join(filter(None, [ctitle or atitle, cwd or proj, (branches or "").replace(",", " ")]))
    if meta_rowid is not None:
        con.execute("DELETE FROM docs WHERE id=?", (meta_rowid,))
    cur = con.execute("INSERT INTO docs(file_id, session_id, role, ts, text) VALUES(0,?,?,?,?)",
                      (sid, "meta", None, text))
    con.execute("UPDATE sessions SET meta_rowid=? WHERE id=?", (cur.lastrowid, sid))


def index_file(con, path, sid, kind, proj, st, hh, mode, force_reset, counters):
    con.execute("BEGIN IMMEDIATE")
    try:
        row = con.execute("SELECT file_id, inode, size, offset, head_hash FROM files WHERE path=?",
                          (path,)).fetchone()
        if row is None:
            file_id = con.execute("SELECT coalesce(max(file_id),0)+1 FROM files").fetchone()[0]
            con.execute("INSERT INTO files VALUES(?,?,?,?,?,?,?,?)",
                        (path, file_id, sid, kind, st.st_ino, 0, 0, hh))
            offset = 0
        else:
            file_id, inode, size, offset, old_hash = row
            if force_reset or inode != st.st_ino or old_hash != hh or st.st_size < offset:
                delete_file_rows(con, file_id)
                offset = 0
                counters["reset"] += 1
        if st.st_size == offset:
            con.execute("UPDATE files SET inode=?, head_hash=? WHERE path=?", (st.st_ino, hh, path))
            con.execute("COMMIT")
            return False
        with open(path, "rb") as f:
            f.seek(offset)
            data = f.read()
        cut = data.rfind(b"\n")
        if cut < 0:
            con.execute("COMMIT")
            return False
        complete = data[:cut + 1]
        ch = Chunk()
        for line in complete.split(b"\n"):
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                ch.skipped += 1
                continue
            extract(rec, kind, mode, ch)
        con.executemany("INSERT INTO docs(file_id, session_id, role, ts, text) VALUES(?,?,?,?,?)",
                        [(file_id, sid, r, ts, tx) for r, ts, tx in ch.docs])
        con.executemany("INSERT INTO prompts VALUES(?,?,?,?,?,?,?,?)",
                        [(file_id, sid) + p for p in ch.prompts])
        con.executemany(
            "INSERT INTO usage VALUES(?,?,?,?,?,?,?,?,?) ON CONFLICT(file_id, msg_id) DO UPDATE SET "
            "input=max(input, excluded.input), output=max(output, excluded.output), "
            "cache_write=max(cache_write, excluded.cache_write), cache_read=max(cache_read, excluded.cache_read)",
            [(file_id, sid, mid) + tuple(v) for mid, v in ch.usage.items()])
        con.executemany("INSERT OR REPLACE INTO edits VALUES(?,?,?,?,?,?,?,?,1)",
                        [(file_id, sid) + e for e in ch.edits])
        con.executemany("UPDATE edits SET ok=0 WHERE session_id=? AND tool_use_id=?",
                        [(sid, e) for e in ch.errors])
        con.executemany("INSERT INTO events VALUES(?,?,?,?,?)", [(file_id, sid) + e for e in ch.events])
        if kind == "main":
            merge_session(con, sid, proj, path, ch)
        else:
            ensure_session(con, sid, proj, ch)
        refresh_meta(con, sid)
        con.execute("UPDATE files SET inode=?, size=?, offset=?, head_hash=? WHERE path=?",
                    (st.st_ino, st.st_size, offset + len(complete), hh, path))
        con.execute("COMMIT")
        counters["rows"] += len(ch.docs)
        counters["skipped"] += ch.skipped
        return True
    except BaseException:
        con.execute("ROLLBACK")
        raise


def index_all(con, root=None):
    t0 = time.time()
    root = root or projects_root()
    mode = get_mode(con)
    counters = collections.Counter()
    seen = set()
    todo = []
    known = {r[0]: r[1:] for r in con.execute("SELECT path, inode, size, offset, head_hash FROM files")}
    reset_sessions = set()
    for path, sid, kind, proj in walk(root):
        seen.add(path)
        try:
            st = os.stat(path)
            hh = head_hash(path)
        except OSError:
            continue
        counters["files"] += 1
        k = known.get(path)
        if k and k[0] == st.st_ino and k[1] == st.st_size and k[3] == hh:
            continue
        if kind == "main" and k and (k[0] != st.st_ino or k[3] != hh or st.st_size < k[2]):
            reset_sessions.add(sid)
        todo.append((path, sid, kind, proj, st, hh))
    if reset_sessions:
        # A main file that must be re-read from 0 invalidates the merged session metadata; re-read
        # every main file of that session so the metadata is rebuilt from all of them.
        for sid in reset_sessions:
            drop_session(con, sid)
        todo_paths = {t[0] for t in todo}
        for path, sid, kind, proj in walk(root):
            if sid in reset_sessions and kind == "main" and path not in todo_paths:
                try:
                    todo.append((path, sid, kind, proj, os.stat(path), head_hash(path)))
                except OSError:
                    pass
    for path, sid, kind, proj, st, hh in todo:
        force = kind == "main" and sid in reset_sessions
        if index_file(con, path, sid, kind, proj, st, hh, mode, force, counters):
            counters["changed"] += 1
    # prune files that no longer exist
    gone = [p for p in known if p not in seen]
    if gone:
        con.execute("BEGIN IMMEDIATE")
        try:
            for p in gone:
                r = con.execute("SELECT file_id, session_id FROM files WHERE path=?", (p,)).fetchone()
                if not r:
                    continue
                delete_file_rows(con, r[0])
                con.execute("DELETE FROM files WHERE path=?", (p,))
                if not con.execute("SELECT 1 FROM files WHERE session_id=? LIMIT 1", (r[1],)).fetchone():
                    drop_session(con, r[1])
                counters["pruned"] += 1
            con.execute("COMMIT")
        except BaseException:
            con.execute("ROLLBACK")
            raise
    counters["secs"] = round(time.time() - t0, 2)
    return counters


# ---------------------------------------------------------------- time helpers


def parse_ts(ts):
    if not ts:
        return None
    try:
        return dt.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None


def local(ts):
    d = parse_ts(ts)
    return d.astimezone() if d else None


def since_cutoff(s):
    """'7d', '12h' or 'YYYY-MM-DD' (local) -> UTC ISO string comparable with transcript timestamps."""
    if not s:
        return None
    m = re.fullmatch(r"(\d+)([dh])", s.strip())
    if m:
        n = int(m.group(1))
        delta = dt.timedelta(days=n) if m.group(2) == "d" else dt.timedelta(hours=n)
        d = dt.datetime.now(dt.timezone.utc) - delta
    else:
        try:
            d = dt.datetime.strptime(s.strip(), "%Y-%m-%d").astimezone().astimezone(dt.timezone.utc)
        except ValueError:
            raise SystemExit(f"ccfind: bad --since value {s!r} (use 7d, 12h or YYYY-MM-DD)")
    return d.strftime("%Y-%m-%dT%H:%M:%S")


def short_project(cwd):
    if not cwd:
        return "?"
    parts = [p for p in cwd.split("/") if p]
    return "/".join(parts[-2:]) if parts else "/"


# ---------------------------------------------------------------- search


def fts_quote(tok):
    star = tok.endswith("*") and len(tok) > 1
    core = tok[:-1] if star else tok
    if not re.search(r"\w", core):
        return None
    return '"' + core.replace('"', '""') + '"' + ("*" if star else "")


RANK_SQL = """
WITH hits AS MATERIALIZED (
  SELECT rowid, session_id, role, bm25(msgs) AS s FROM msgs WHERE msgs MATCH ?)
SELECT session_id, min(s) AS best, count(*) AS n_hits,
       max(CASE WHEN role='meta' THEN 1 ELSE 0 END) AS title_hit
FROM hits {where} GROUP BY session_id
"""


def search(con, terms, any_=False, raw=False, no_agents=False, no_tmp=False, exclude_current=False,
           project=None, branch=None, since=None, limit=10):
    excluded_roles = ["tool"] if get_mode(con) != "deep" else []
    if no_agents:
        excluded_roles.append("agent")
    where = ""
    if excluded_roles:
        where = "WHERE role NOT IN (%s)" % ",".join("'%s'" % r for r in excluded_roles)
    if raw:
        queries = [" ".join(terms)]
        or_q = queries[0]
    else:
        queries = [q for q in (fts_quote(t) for t in terms) if q]
        if not queries:
            return []
        or_q = " OR ".join(queries)
    try:
        rows = con.execute(RANK_SQL.format(where=where), (or_q,)).fetchall()
        if not any_ and not raw and len(queries) > 1:
            keep = None
            for q in queries:
                s = {r[0] for r in con.execute(
                    "SELECT DISTINCT session_id FROM msgs WHERE msgs MATCH ?" +
                    (" AND " + where[6:] if where else ""), (q,))}
                keep = s if keep is None else keep & s
            rows = [r for r in rows if r[0] in keep]
    except sqlite3.OperationalError as e:
        if raw:
            raise SystemExit("ccfind: invalid query syntax (%s)" % e)
        raise
    if not rows:
        return []
    meta = {}
    ids = [r[0] for r in rows]
    for i in range(0, len(ids), 500):
        part = ids[i:i + 500]
        for s in con.execute("SELECT id, cwd, project_dir, branches, custom_title, ai_title, first_prompt, "
                             "started, ended, path, is_tmp, n_msgs FROM sessions WHERE id IN (%s)"
                             % ",".join("?" * len(part)), part):
            meta[s[0]] = s
    cutoff = since_cutoff(since)
    current = os.environ.get("CLAUDE_CODE_SESSION_ID") if exclude_current else None
    now = dt.datetime.now(dt.timezone.utc)
    scored = []
    for sid, best, n_hits, title_hit in rows:
        m = meta.get(sid)
        if not m:
            continue
        _, cwd, proj, branches, ctitle, atitle, first, started, ended, path, is_tmp, n_msgs = m
        if no_tmp and is_tmp:
            continue
        if current and sid == current:
            continue
        if project and project.lower() not in (cwd or "").lower() and project.lower() not in (proj or "").lower():
            continue
        if branch and not any(branch.lower() in b.lower() for b in (branches or "").split(",")):
            continue
        if cutoff and (ended or "") < cutoff:
            continue
        e = parse_ts(ended)
        age = (now - e).total_seconds() / 86400 if e else 365
        recency = 0.1 / (1 + age / 30)
        score = best * (1.5 if title_hit else 1.0) - 0.05 * math.log1p(n_hits) - recency
        scored.append((score, sid, m, n_hits))
    scored.sort(key=lambda x: x[0])
    out = []
    for rank, (score, sid, m, n_hits) in enumerate(scored[:limit], 1):
        _, cwd, proj, branches, ctitle, atitle, first, started, ended, path, is_tmp, n_msgs = m
        snip = snippet(con, or_q, sid, where)
        out.append({"rank": rank, "id": sid, "cwd": cwd, "project": short_project(cwd or proj),
                    "branch": (branches or "").replace(",", ", "), "title": ctitle or atitle or first or "",
                    "started": started, "ended": ended, "snippet": snip, "path": path,
                    "hits": n_hits, "messages": n_msgs, "score": round(score, 4)})
    return out


def snippet(con, or_q, sid, where):
    extra = (" AND " + where[6:]) if where else ""
    for cond in (" AND role != 'meta'", ""):
        try:
            r = con.execute("SELECT snippet(msgs, 4, '[', ']', '…', 14) FROM msgs WHERE msgs MATCH ? "
                            "AND session_id = ?" + cond + extra + " ORDER BY rank LIMIT 1", (or_q, sid)).fetchone()
        except sqlite3.OperationalError:
            r = con.execute("WITH h AS MATERIALIZED (SELECT snippet(msgs, 4, '[', ']', '…', 14) AS sn, "
                            "bm25(msgs) AS s, session_id, role FROM msgs WHERE msgs MATCH ?) "
                            "SELECT sn FROM h WHERE session_id = ?" + cond + " ORDER BY s LIMIT 1",
                            (or_q, sid)).fetchone()
        if r and r[0]:
            return " ".join(r[0].split())
    return ""


def print_results(res):
    if not res:
        print("no matches")
        return
    for r in res:
        d = local(r["ended"])
        date = d.strftime("%Y-%m-%d %H:%M") if d else "?"
        title = " ".join((r["title"] or "").split())[:80]
        branch = (r["branch"] or "-").split(", ")[0]
        print(f"{r['rank']:>2}  {date}  {r['project']}  [{branch}]  {title}")
        if r["snippet"]:
            print(f"      {r['snippet'][:160]}")
        print(f"      id: {r['id']}")


def save_last(res):
    try:
        with open(last_path(), "w") as f:
            json.dump([r["id"] for r in res], f)
        os.chmod(last_path(), 0o600)
    except OSError:
        pass


# ---------------------------------------------------------------- open / show


def resolve_id(con, ref):
    if re.fullmatch(r"\d{1,3}", ref):
        try:
            with open(last_path()) as f:
                ids = json.load(f)
        except (OSError, ValueError):
            ids = []
        i = int(ref)
        if 1 <= i <= len(ids):
            return ids[i - 1]
        raise SystemExit(f"ccfind: no result #{ref} from the last search")
    rows = [r[0] for r in con.execute("SELECT id FROM sessions WHERE id LIKE ? ORDER BY ended DESC",
                                      (ref.replace("%", "").replace("_", "\\_") + "%",))]
    if len(rows) == 1:
        return rows[0]
    if not rows:
        raise SystemExit(f"ccfind: no session matches {ref!r}")
    print("ambiguous id prefix; candidates:", file=sys.stderr)
    for r in rows[:20]:
        print("  " + r, file=sys.stderr)
    sys.exit(2)


def cmd_open(con, args):
    sid = resolve_id(con, args.ref)
    row = con.execute("SELECT cwd, path FROM sessions WHERE id=?", (sid,)).fetchone()
    cwd, path = row if row else (None, None)
    exists = bool(cwd) and os.path.isdir(cwd)
    if exists:
        print(f"cd {shlex.quote(cwd)} && claude --resume {sid}")
    else:
        print(f"claude --resume {sid}")
        print(f"ccfind: working directory {cwd or '?'} no longer exists; resuming without cd", file=sys.stderr)
    if not args.x:
        return 0
    if os.environ.get("CLAUDECODE"):
        print("ccfind: refusing -x inside a Claude Code session (it would nest sessions); "
              "run the command above in a terminal", file=sys.stderr)
        return 3
    try:
        if path and time.time() - os.stat(path).st_mtime < LIVE_SECS:
            print("ccfind: warning: this session was written to in the last 2 minutes and may be open "
                  "elsewhere; consider `claude --resume %s --fork-session`" % sid, file=sys.stderr)
    except OSError:
        pass
    if exists:
        os.chdir(cwd)
    os.execvp("claude", ["claude", "--resume", sid])


def cmd_show(con, args):
    sid = resolve_id(con, args.ref)
    sql = "SELECT d.role, d.ts, d.text FROM docs d WHERE d.session_id=? AND d.role IN ('user','assistant')"
    params = [sid]
    if args.g:
        q = fts_quote(args.g)
        if not q:
            return 0
        sql += " AND d.id IN (SELECT rowid FROM msgs WHERE msgs MATCH ?)"
        params.append(q)
    sql += " ORDER BY d.ts, d.id"
    for role, ts, text in con.execute(sql, params):
        d = local(ts)
        stamp = d.strftime("%Y-%m-%d %H:%M") if d else "?"
        body = " ".join((text or "").split())
        print(f"[{role} {stamp}] {body[:500]}")
    return 0


# ---------------------------------------------------------------- stats

STOPWORDS = set("""
